# ===================================================
# Khaled Auto Spares (KAS) - Environment Configuration
# ===================================================

# ---------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ---------------------------------------------------
# Production backend API endpoint URL (no trailing slash)
# Leave empty for local development to use Vite's dev proxy
VITE_API_URL=https://your-backend-service.up.railway.app

# ---------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Railway / Render)
# ---------------------------------------------------
PORT=5000
NODE_ENV=production

# Client origin for CORS (comma-separated if multiple domains)
CLIENT_URL=https://kas-gamma-woad.vercel.app
CORS_ORIGIN=https://kas-gamma-woad.vercel.app,http://localhost:3000,http://localhost:5173

# ---------------------------------------------------
# 3. SUPABASE DATABASE & STORAGE CONFIGURATION
# ---------------------------------------------------
# Supabase PostgreSQL Pooler URL (Transaction Mode: Port 6543)
# If unset, the backend will automatically use the local SQLite database
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase API & Cloud Storage (for product images & uploads)
SUPABASE_URL=https://[your-project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...[your-service-role-secret-key]
SUPABASE_ANON_KEY=eyJhbGciOi...[your-anon-public-key]
SUPABASE_STORAGE_BUCKET=product-images

# ---------------------------------------------------
# 4. INITIAL ADMIN DASHBOARD CREDENTIALS
# ---------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@kas.dz
ADMIN_PASSWORD=adminpassword123
ADMIN_NAME=KAS Administrator
