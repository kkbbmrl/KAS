# ===================================================
# Khaled Auto Spares (KAS) - Environment Configuration
# ===================================================

# ---------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ---------------------------------------------------
# Production Railway API endpoint URL (no trailing slash)
# Leave empty for local development to use the Vite dev server proxy
VITE_API_URL=https://your-backend-service.up.railway.app

# ---------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Railway)
# ---------------------------------------------------
# Port is automatically assigned by Railway at runtime
PORT=5000
NODE_ENV=production

# Client origin for CORS (comma-separated if multiple domains)
CLIENT_URL=https://kas-gamma-woad.vercel.app
CORS_ORIGIN=https://kas-gamma-woad.vercel.app,http://localhost:3000,http://localhost:5173

# PostgreSQL Database URL (automatically provided by Railway PostgreSQL plugin)
# If left unset, the backend will automatically use the local SQLite database
DATABASE_URL=postgresql://postgres:password@junction.proxy.rlwy.net:5432/railway

# Initial Admin Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=contact@khaledautospart.dz
ADMIN_PASSWORD=change_this_to_a_secure_password
ADMIN_NAME=KAS Administrator
